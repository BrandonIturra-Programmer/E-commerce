<% titulo = 'MiEcommerce - Inicio' %>

<div class="categorias">
  <div class="categoria-item">🖥️ <span>Electrónica</span></div>
  <div class="categoria-item">🍔 <span>Alimentos</span></div>
  <div class="categoria-item">🍺 <span>Bebidas</span></div>
  <div class="categoria-item">👕 <span>Indumentaria</span></div>
  <div class="categoria-item">🎮 <span>Juegos</span></div>
  <div class="categoria-item">🚗 <span>Automotor</span></div>
  <div class="categoria-item">🛋️ <span>Hogar</span></div>
  <div class="categoria-item">🎁 <span>Otros</span></div>
</div>

<div class="banner">
  <div class="banner-card">
    <img src="/img/disney.png" alt="Disney+" onerror="this.style.display='none'"/>
    <div class="banner-info">
      <p class="banner-descuento">50% OFF en Combo Plus</p>
      <p class="banner-detalle">Canjeando 50.000 puntos MiEcommerce.</p>
    </div>
  </div>
  <div class="banner-card">
    <img src="/img/hbo.png" alt="HBO Max" onerror="this.style.display='none'"/>
    <div class="banner-info">
      <p class="banner-descuento">50% OFF en HBO Max</p>
      <p class="banner-detalle">Canjeando 50.000 puntos MiEcommerce.</p>
    </div>
  </div>
</div>

<!-- US6 - Productos sugeridos -->
<h2 class="seccion-titulo">Te puede interesar</h2>
<div class="productos-grid">
  <% sugeridos.forEach(producto => { %>
    <a href="/productos/<%= producto.id %>">
      <div class="producto-card">
        <img src="/img/<%= producto.imagen %>" alt="<%= producto.nombre %>"/>
        <div class="producto-card__info">
          <p class="producto-card__nombre"><%= producto.nombre %></p>
          <p class="producto-card__precio"><%= producto.precio %> <span>PUNTOS</span></p>
        </div>
      </div>
    </a>
  <% }) %>
</div>

<!-- US7 - Más pedidos -->
<h2 class="seccion-titulo">Los más pedidos</h2>
<div class="productos-grid">
  <% masPedidos.forEach(producto => { %>
    <a href="/productos/<%= producto.id %>">
      <div class="producto-card">
        <img src="/img/<%= producto.imagen %>" alt="<%= producto.nombre %>"/>
        <div class="producto-card__info">
          <p class="producto-card__nombre"><%= producto.nombre %></p>
          <p class="producto-card__precio"><%= producto.precio %> <span>PUNTOS</span></p>
        </div>
      </div>
    </a>
  <% }) %>
</div>