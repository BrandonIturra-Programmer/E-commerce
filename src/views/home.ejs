    <span>Electrónica</span>
  </a>
  <a href="/productos/categoria/Alimentos" class="categoria-item">
    <i class="fa-solid fa-burger"></i>
    <span>Alimentos</span>
  </a>
  <a href="/productos/categoria/Bebidas" class="categoria-item">
    <i class="fa-solid fa-beer-mug-empty"></i>
    <span>Bebidas</span>
  </a>
  <a href="/productos/categoria/Indumentaria" class="categoria-item">
    <i class="fa-solid fa-shirt"></i>
    <span>Indumentaria</span>
  </a>
  <a href="/productos/categoria/Juegos" class="categoria-item">
    <i class="fa-solid fa-gamepad"></i>
    <span>Juegos</span>
  </a>
  <a href="/productos/categoria/Automotor" class="categoria-item">
    <i class="fa-solid fa-car"></i>
    <span>Automotor</span>
  </a>
  <a href="/productos/categoria/Hogar" class="categoria-item">
    <i class="fa-solid fa-house"></i>
    <span>Hogar</span>
  </a>
  <a href="/productos/categoria/Otros" class="categoria-item">
    <i class="fa-solid fa-gift"></i>
    <span>Otros</span>
  </a>
</div>

<!-- Banner-->
</main>
<div class="banner-wrapper">
  <div class="banner">
    <div class="banner-card banner-card-disney">
      <div class="banner-overlay">
        <img src="/img/logo-disney.jpg" alt="Disney+" class="banner-logo"/>
        <div class="banner-info">
          <p class="banner-descuento">50% OFF en Combo Plus</p>
          <p class="banner-detalle">Canjeando 50.000 puntos MiEcommerce.</p>
        </div>
      </div>
    </div>
    <div class="banner-card banner-card-hbo">
      <div class="banner-overlay">
        <img src="/img/logo-hbo.jpg" alt="HBO Max" class="banner-logo"/>
        <div class="banner-info">
          <p class="banner-descuento">50% OFF en HBO Max</p>
          <p class="banner-detalle">Canjeando 50.000 puntos MiEcommerce.</p>
        </div>
      </div>
    </div>
  </div>
</div>
<main class="container">


<!-- US6 - Productos sugeridos -->
<h2 class="seccion-titulo">Te puede interesar</h2>
<div class="productos-grid">
  <% sugeridos.forEach(producto => { %>
    <a href="/productos/<%= producto.id %>">
      <div class="producto-card">
        <img src="/img/<%= producto.imagen %>" alt="<%= producto.nombre %>"/>
        <div class="producto-card__info">
          <p class="producto-card__nombre"><%= producto.nombre %></p>
          <p class="producto-card__precio"><%= producto.precio %> <span>PUNTOS</span></p>
        </div>
      </div>
    </a>
  <% }) %>
</div>

<!-- US7 - Más pedidos -->
<h2 class="seccion-titulo">Los más pedidos</h2>
<div class="productos-grid">
  <% masPedidos.forEach(producto => { %>
    <a href="/productos/<%= producto.id %>">
      <div class="producto-card">
        <img src="/img/<%= producto.imagen %>" alt="<%= producto.nombre %>"/>
        <div class="producto-card__info">
          <p class="producto-card__nombre"><%= producto.nombre %></p>
          <p class="producto-card__precio"><%= producto.precio %> <span>PUNTOS</span></p>
        </div>
      </div>
    </a>
  <% }) %>
</div>