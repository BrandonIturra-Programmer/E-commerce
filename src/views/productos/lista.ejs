<% titulo = 'Productos - MiEcommerce' %>

<h2 class="seccion-titulo">Todos los productos</h2>
<div class="productos-horizontal">
  <% productos.forEach(producto => { %>
    <a href="/productos/<%= producto.id %>" class="producto-card-h">
      <img src="/img/<%= producto.imagen %>" alt="<%= producto.nombre %>" onerror="this.src='/img/fallback.jpg'"/>
      <div class="producto-card-h__bottom">
        <div class="producto-card-h__bottom-info">
          <p class="producto-card-h__nombre"><%= producto.nombre %></p>
          <p class="producto-card-h__precio"><%= producto.precio.toLocaleString() %> <span>PUNTOS</span></p>
        </div>
        <div class="producto-card-h__separador"></div>
        <div class="producto-card-h__carrito">
          <i class="fa-solid fa-cart-shopping"></i>
        </div>
      </div>
    </a>
  <% }) %>
</div>