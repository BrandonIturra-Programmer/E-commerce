<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Login - MiEcommerce</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="auth-wrapper">
    <div class="auth-banner"></div>

    <div class="auth-card">
      <h1>¡Hola!</h1>

      <input type="text" placeholder="Tu nombre de usuario" class="auth-input"/>
      <input type="password" placeholder="Tu contraseña" class="auth-input"/>

      <button class="auth-btn">Iniciar Sesión</button>

      <p class="auth-link">
        ¿No tienes cuenta? <a href="/auth/registro">Regístrate</a>
      </p>
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>