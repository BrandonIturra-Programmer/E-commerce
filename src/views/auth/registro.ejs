<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro - MiEcommerce</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="auth-wrapper">
    <div class="auth-banner"></div>

    <div class="auth-card">
      <h1>¡Registrate!</h1>

      <input type="email" placeholder="Tu email" class="auth-input"/>
      <input type="password" placeholder="Tu nueva contraseña" class="auth-input"/>
      <input type="password" placeholder="Repite tu contraseña" class="auth-input"/>

      <button class="auth-btn">Crear Cuenta</button>

      <p class="auth-link">
        ¿Ya tienes cuenta? <a href="/auth/login">Inicia Sesión</a>
      </p>
    </div>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>