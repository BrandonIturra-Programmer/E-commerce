<% titulo = 'Registro - MiEcommerce' %>

<div class="auth-wrapper">
  <div class="auth-banner"></div>
  <div class="auth-card">
    <h1>¡Registro!</h1>

    <% if(errores.length > 0) { %>
      <div class="auth-errores">
        <% errores.forEach(error => { %>
          <p>⚠️ <%= error %></p>
        <% }) %>
      </div>
    <% } %>

    <form action="/auth/registro" method="POST">
      <div class="auth-input-group">
        <i class="fa-regular fa-user auth-input-icon"></i>
        <input type="text" name="nombre" placeholder="Nombre" class="auth-input"/>
      </div>
      <div class="auth-input-group">
        <i class="fa-regular fa-user auth-input-icon"></i>
        <input type="text" name="apellido" placeholder="Apellido" class="auth-input"/>
      </div>
      <div class="auth-input-group">
        <i class="fa-regular fa-envelope auth-input-icon"></i>
        <input type="email" name="email" placeholder="Email" class="auth-input"/>
      </div>
      <div class="auth-input-group">
        <i class="fa-solid fa-lock auth-input-icon"></i>
        <input type="password" name="password" placeholder="Contraseña" class="auth-input"/>
      </div>
      <div class="auth-input-group">
        <i class="fa-solid fa-lock auth-input-icon"></i>
        <input type="password" name="repetirPassword" placeholder="Repite tu contraseña" class="auth-input"/>
      </div>
      <button type="submit" class="auth-btn">Crear Cuenta</button>
    </form>

    <p class="auth-link">
      ¿Ya tienes cuenta? <a href="/auth/login">Inicia Sesión</a>
    </p>
  </div>
</div>